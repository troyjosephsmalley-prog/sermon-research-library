{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/sds/LIBRARY-INDEX.schema.json",
  "title": "SDS Research Library Discovery Index",
  "type": "object",
  "required": [
    "index_version",
    "sources"
  ],
  "properties": {
    "index_version": {
      "type": "string"
    },
    "generated_or_updated": {
      "type": [
        "string",
        "null"
      ]
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "source_id",
          "title",
          "source_class",
          "card_path"
        ],
        "properties": {
          "source_id": {
            "type": "string"
          },
          "author": {
            "type": [
              "string",
              "null"
            ]
          },
          "title": {
            "type": "string"
          },
          "year": {
            "type": [
              "integer",
              "null"
            ]
          },
          "source_class": {
            "type": "string"
          },
          "card_path": {
            "type": "string"
          },
          "biblical_books": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "uniqueItems": true
          },
          "passages": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "uniqueItems": true
          },
          "topics": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "uniqueItems": true
          },
          "competence": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "uniqueItems": true
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}