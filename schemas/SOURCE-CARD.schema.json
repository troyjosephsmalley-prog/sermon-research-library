{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/sds/SOURCE-CARD.schema.json",
  "title": "SDS Research Library Source Card",
  "type": "object",
  "required": [
    "source_id",
    "bibliography",
    "source_class",
    "library",
    "competence",
    "coverage",
    "claims"
  ],
  "properties": {
    "source_id": {
      "type": "string",
      "minLength": 3
    },
    "bibliography": {
      "type": "object",
      "required": [
        "author",
        "title"
      ],
      "properties": {
        "author": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "editor": {
          "type": [
            "string",
            "null"
          ]
        },
        "series": {
          "type": [
            "string",
            "null"
          ]
        },
        "publisher": {
          "type": [
            "string",
            "null"
          ]
        },
        "year": {
          "type": [
            "integer",
            "null"
          ]
        },
        "edition": {
          "type": [
            "string",
            "null"
          ]
        },
        "isbn_doi_url": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false
    },
    "source_class": {
      "enum": [
        "TEXT_CRITICAL_RESOURCE",
        "GRAMMAR_SYNTAX",
        "LEXICON_SEMANTICS",
        "LITERARY_DISCOURSE",
        "HISTORICAL_CULTURAL",
        "TECHNICAL_COMMENTARY",
        "MONOGRAPH_ARTICLE",
        "ANCIENT_PRIMARY_SOURCE",
        "CANONICAL_INTERTEXT",
        "CONFESSIONAL_THEOLOGICAL",
        "HOMILETICAL_SYNTHESIS"
      ]
    },
    "library": {
      "type": "object",
      "required": [
        "provider",
        "path_or_locator"
      ],
      "properties": {
        "provider": {
          "enum": [
            "GOOGLE_DRIVE",
            "CHATGPT_LIBRARY",
            "LOCAL",
            "OTHER"
          ]
        },
        "path_or_locator": {
          "type": "string"
        },
        "file_name": {
          "type": [
            "string",
            "null"
          ]
        },
        "edition_note": {
          "type": [
            "string",
            "null"
          ]
        },
        "checksum": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false
    },
    "competence": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "coverage": {
      "type": "object",
      "properties": {
        "biblical_books": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "passages": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "topics": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        }
      },
      "additionalProperties": false
    },
    "notes": {
      "type": "object",
      "properties": {
        "independence_group": {
          "type": [
            "string",
            "null"
          ]
        },
        "dependencies": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "general_note": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false
    },
    "claims": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "claim_id",
          "summary",
          "location",
          "contribution",
          "confidence"
        ],
        "properties": {
          "claim_id": {
            "type": "string"
          },
          "passage": {
            "type": [
              "string",
              "null"
            ]
          },
          "issue": {
            "type": [
              "string",
              "null"
            ]
          },
          "claim_type": {
            "type": [
              "string",
              "null"
            ]
          },
          "summary": {
            "type": "string"
          },
          "location": {
            "type": "string"
          },
          "quotation": {
            "type": [
              "string",
              "null"
            ]
          },
          "contribution": {
            "enum": [
              "ESTABLISHES",
              "SUPPORTS",
              "QUALIFIES",
              "DISPUTES",
              "BACKGROUND_ONLY",
              "ILLUSTRATES_OR_SYNTHESISES"
            ]
          },
          "confidence": {
            "enum": [
              "LOW",
              "MODERATE",
              "HIGH"
            ]
          },
          "contested": {
            "type": "boolean",
            "default": false
          },
          "independence_group": {
            "type": [
              "string",
              "null"
            ]
          },
          "alternatives": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}